## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Development certificates and private keys, written by the pki-init service.
# Local development only — the worker key is a credential the internal listener
# accepts, and the authority key can mint another. Tracked directory (via .gitkeep)
# for the same reason .openbao is: on Linux, Docker creates a missing bind-mount
# source as root, which then breaks a non-root `docker compose up`.
.pki/*
!.pki/.gitkeep

# OpenBao unseal key + root token, written by the openbao-init service.
# Local development only — these decrypt everything in the openbao-data volume.
# The directory itself is tracked (via .gitkeep) so it exists on a fresh clone
# owned by the cloning user: on Linux, Docker creates a missing bind-mount source
# as root, which then breaks a non-root `docker compose up`. Its contents are
# never tracked.
.openbao/*
!.openbao/.gitkeep

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml
