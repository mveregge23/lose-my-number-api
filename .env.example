#
# Copy to .env and override before running anywhere a network can reach.
# docker-compose.yml falls back to these same dev defaults when .env is absent,
# so `docker compose up` works on a fresh clone with no setup step.

POSTGRES_USER=dbr
POSTGRES_PASSWORD=dbr_dev_password
POSTGRES_DB=dbr
POSTGRES_PORT=5432

RABBITMQ_USER=dbr
RABBITMQ_PASSWORD=dbr_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Dev-mode root token. A real deployment uses a scoped token or an auth method,
# never a root token, and OpenBao runs with a persistent storage backend.
BAO_TOKEN=dbr_dev_root_token
BAO_PORT=8200

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
