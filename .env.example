#
# Copy to .env and override before running anywhere a network can reach.
# docker-compose.yml falls back to these same dev defaults when .env is absent,
# so `docker compose up` works on a fresh clone with no setup step.

POSTGRES_USER=dbr
POSTGRES_PASSWORD=dbr_dev_password
POSTGRES_DB=dbr
POSTGRES_PORT=5432

RABBITMQ_USER=dbr
RABBITMQ_PASSWORD=dbr_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# The id of the token the API authenticates to OpenBao with. It is scoped to
# openbao/policies/dbr-api.hcl — not a root token — so what it can do is whatever
# that file grants and nothing else. A real deployment issues this through an auth
# method so it rotates, rather than minting one with a fixed id.
BAO_TOKEN=dbr_dev_api_token
BAO_PORT=8200

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Where a browser reaches this instance. Passkeys are bound to the relying party's
# domain and offered nowhere else, so these describe the address people visit rather
# than the address the API listens on. Change API_PORT and PASSKEY_ORIGIN has to
# follow, or the browser refuses every ceremony before the server sees it.
PASSKEY_RELYING_PARTY_ID=localhost
PASSKEY_ORIGIN=http://localhost:8080

# Signs access tokens. Replace this before anyone but you can reach the API:
# whoever knows it can mint a token for any account. At least 32 bytes —
# `openssl rand -base64 48` produces a suitable value.
TOKEN_SIGNING_KEY=dbr_dev_token_signing_key_do_not_use_in_production

# Which version of the terms an account is opened under. Signup records it against
# the profile it creates, so it is what answers "what did this person actually agree
# to" once the wording has moved on. Point it at the text this instance really
# serves; the placeholder below names no document at all.
TERMS_VERSION=2026-06-01

# Which version of the consent text a grant or revocation is recorded against. A
# separate document from the terms, versioned separately: rewording what the system
# may do on somebody's behalf should not invalidate their attestation that the
# identity in their profile is their own. The placeholder below names no document
# either.
CONSENT_POLICY_VERSION=2026-06-01

# Outbound mail. MAIL_DOMAIN is the one value here with no safe default: every
# demand carries a return address on it, and a company's reply goes wherever it
# points — so a default would send this instance's replies to a domain somebody
# else owns. The dev value below is deliberately unroutable.
#
# `docker compose up` brings up Postal and points the worker at it, which is enough
# to compose and hand over demands. Actually delivering them needs a domain you
# control, its DNS records, and outbound port 25 — see the mail section of the
# README.
MAIL_DOMAIN=removals.localhost.test
# The relay to hand demands to. Defaults to the bundled Postal; point these at your own
# relay instead and stop the postal-* services — the application only ever knows how to
# hand a message to something that speaks SMTP.
MAIL_HOST=postal-smtp
# 25 for the bundled relay, which never leaves the compose network. A relay reached across
# a network wants 587 (submission), and MAIL_REQUIRE_TLS on with it.
MAIL_PORT=25
MAIL_USERNAME=dbr
# The SMTP credential the worker authenticates with. Postal looks a credential up
# by this value alone, so it is the whole of the secret — replace it before this
# stack is reachable from a network.
MAIL_PASSWORD=dbr_dev_smtp_credential
# Off on the compose network, where the relay is a container without a certificate
# for a hostname that resolves nowhere else. Turn it on anywhere the relay is
# reached across a network.
MAIL_REQUIRE_TLS=false

# Postal's own database, session secret, and the administrator that owns the
# organisation the worker sends through. The web interface is off the host by
# default; reach it through the dev-ports overlay.
POSTAL_DB_PASSWORD=postal_dev_password
POSTAL_SECRET_KEY=postal_dev_secret_key_do_not_use_in_production
POSTAL_ADMIN_EMAIL=admin@example.com
POSTAL_ADMIN_PASSWORD=postal_dev_password
POSTAL_WEB_PORT=5000
