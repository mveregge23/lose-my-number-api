<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- EF1002 warns that raw SQL built from an interpolated string is an injection
         risk. Every raw query in this project interpolates a table name, and a table
         name cannot be a parameter — so the alternative is not a safer query, it is no
         query. The interpolated values are literals and Guids these tests generate
         themselves; nothing here comes from outside the test. Scoped to this project
         so the warning still bites anywhere the input might not be ours. -->
    <NoWarn>$(NoWarn);EF1002</NoWarn>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosts the real API in-process: real routing, real bearer authentication, the
         real tenant middleware and the real interceptor, over the Testcontainers
         Postgres below. Nothing is substituted, which is the point — a pipeline with
         a stubbed step is a pipeline that answers a question nobody asked. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- The generic builder, for OpenBao: there is no first-party module for it. -->
    <PackageReference Include="Testcontainers" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dbr.Infrastructure\Dbr.Infrastructure.csproj" />
    <!-- The tests run the real migrator rather than a copy of what it does. Anything
         else would be asserting against a second implementation of the schema, which
         can agree with the tests while disagreeing with what production applies. -->
    <ProjectReference Include="..\..\src\Dbr.Migrator\Dbr.Migrator.csproj" />
    <ProjectReference Include="..\..\src\Dbr.Api\Dbr.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
