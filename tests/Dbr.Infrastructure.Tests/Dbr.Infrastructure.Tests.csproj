<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 runs tests through Microsoft.Testing.Platform: each test project is
         a self-contained executable rather than something a separate VSTest host
         discovers. That is what makes running one project at a time straightforward,
         which CI needs in order to skip integration suites a change can't have
         affected. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!-- In-memory configuration for the composition-root tests. Only the tests need
         a concrete provider; Dbr.Infrastructure itself depends on the abstraction. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <!-- A real host, so the logging tests can assert against the pipeline the
         composition roots actually build rather than a second one assembled to match.
         The point of those tests is which providers are attached, and a hand-built
         LoggerConfiguration cannot be wrong about that in the way a host can. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dbr.Infrastructure\Dbr.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
