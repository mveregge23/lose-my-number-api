<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The Npgsql provider brings Microsoft.EntityFrameworkCore in transitively;
         it is deliberately not pinned separately so the two can never skew.

         Microsoft.EntityFrameworkCore.Design / .Tools are deliberately absent from
         this project and from every project that references it. The schema is owned
         by hand-written SQL under /db/migrations, and leaving the design-time package
         out is what removes `dotnet ef migrations add` from the set of commands that
         can be run at all — rather than relying on people not running it. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- snake_case identifiers, so the EF model and the hand-written SQL describe
         the same names without quoting either side. A package rather than a
         hand-rolled rewriter: this one also renames keys, indexes and check
         constraints consistently, and model/SQL drift is already the standing cost of
         owning the schema by hand — a second naming implementation would be one more
         place for that drift to start. -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- WebAuthn: the attestation and assertion verification behind passkeys. MIT,
         and the only maintained .NET implementation of a specification whose whole
         value is in the details of the checks — a hand-rolled version would be a
         second implementation of exactly the cryptography this is trusting.

         ASP.NET Core Identity is deliberately not here, despite being the obvious
         partner for it. Identity brings its own EF-owned schema and its own user
         table, and this codebase already has a tenant table and a schema owned by
         hand-written SQL; taking Identity would mean either two sources of truth for
         who an account is, or fighting its store abstractions to point at one. -->
    <PackageReference Include="Fido2" Version="4.0.1" />
    <!-- Signs access tokens. Referenced directly rather than leaned on as a
         transitive dependency of Fido2, which happens to bring an older copy of the
         same library: relying on that would make the token format depend on what a
         WebAuthn package chose. The validating half lives in Dbr.Api, which brings
         its own — one assembly is resolved for the whole application, so the code
         that signs and the code that checks are always the same version. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <!-- Only the abstraction, so this layer reads configuration but never owns a
         provider chain: the composition roots decide where settings come from. The
         binder is the reading half of that, not a provider — it turns a section this
         layer was handed into an options object. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.4" />
    <!-- Typed HttpClient for the key manager. The factory rather than a hand-built
         client because it recycles handlers on a schedule; a long-lived HttpClient
         pins DNS forever, which matters for a service every write depends on. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.4" />
    <!-- Logging, here rather than in each host, because the redaction that makes a log
         line safe to write is a property of this application and not of whichever
         process is writing it. Both composition roots configure logging through one
         call for the same reason they open a database connection through one: a host
         that assembled its own pipeline could assemble one without the redactor, and
         nothing at the call site would look wrong.

         Serilog rather than the built-in logger because the redaction step needs to see
         a log event as structured properties and rewrite them before any sink runs.
         Microsoft.Extensions.Logging has no equivalent seam — its filters decide
         whether an event is written, not what it contains. -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <!-- One JSON object per line for anything that is not a developer's terminal. The
         log stream is going to an OTLP sink later, and a formatter that has already
         separated the properties from the prose is what makes the redacted values
         still legible after that hop. -->
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <!-- So an operator keeps the level control they had before this, through settings
         rather than a rebuild. Configuration is read first and the redactor is attached
         afterwards, which is what stops a configured pipeline from being one without
         it. -->
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dbr.Domain\Dbr.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The exact SQL the tenant interceptor sends is an implementation detail to
         callers, but its precise shape is what the tenant boundary depends on, so it
         is worth asserting in a test. -->
    <InternalsVisibleTo Include="Dbr.Infrastructure.Tests" />
  </ItemGroup>

</Project>
