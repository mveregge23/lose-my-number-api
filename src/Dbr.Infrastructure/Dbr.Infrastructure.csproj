<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The Npgsql provider brings Microsoft.EntityFrameworkCore in transitively;
         it is deliberately not pinned separately so the two can never skew.

         Microsoft.EntityFrameworkCore.Design / .Tools are deliberately absent from
         this project and from every project that references it. §18.6: the schema is
         owned by DbUp (DBR-066), and leaving the design-time package out removes
         `dotnet ef migrations add` from the set of commands that can even be run
         here, rather than relying on people not running it. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- snake_case identifiers, so the EF model and the hand-written SQL of §18
         describe the same names without quoting either side. See the DBR-003
         decision entry for why this is a package and not thirty lines in-repo. -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Only the abstraction, so this layer reads configuration but never owns a
         provider chain: the composition roots decide where settings come from. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dbr.Domain\Dbr.Domain.csproj" />
  </ItemGroup>

</Project>
