<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Dbr.Migrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- DbUp and Npgsql, and nothing else. No configuration-binding packages
         either: the two connection strings are read straight from the environment,
         which is how compose and a CI/CD pre-deploy step both supply them anyway.

         Deliberately no reference to Dbr.Domain or Dbr.Infrastructure. The test that
         checks the hand-written schema still matches the EF model runs the real
         migrator against a real database; if the migrator could see the model, that
         test would be comparing the model against itself and would pass no matter
         how far the two had drifted. -->
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scripts live at /db/migrations, where they are reviewable as SQL and
         covered by their own CODEOWNERS entry, but they are compiled into the
         assembly rather than read off disk. That way the identical artifact runs as a
         compose one-shot and as a hosted pre-deploy step with no path to configure
         and no volume to mount, and "the binary and the scripts disagree" becomes
         impossible rather than merely unlikely.

         LogicalName flattens each script to "<set>.<filename>", which is both how
         MigrationSet selects its own scripts and — since the filenames are
         timestamp-prefixed — how DbUp's name ordering becomes chronological. -->
    <EmbeddedResource Include="..\..\db\migrations\core\*.sql" LogicalName="core.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\db\migrations\vault\*.sql" LogicalName="vault.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
